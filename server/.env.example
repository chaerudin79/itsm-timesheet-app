# Port for the backend server
PORT=8787

# Shared secret the frontend must send in the "x-api-key" header.
# Generate any random string, e.g.: openssl rand -hex 32
BACKEND_API_KEY=change-me-to-a-random-secret

# CORS: comma-separated list of origins allowed to call this backend.
# For local dev with Vite this is usually http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# --- Google Service Account credentials ---
# Create these in Google Cloud Console -> IAM & Admin -> Service Accounts
# -> Create Service Account -> Keys -> Add Key -> JSON.
# Then open the JSON file and copy the two fields below.
# IMPORTANT: you must also share the target Google Sheet with
# GOOGLE_CLIENT_EMAIL (as an Editor), otherwise the service account
# cannot read/write it.
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Keep the quotes and \n exactly as they appear in the downloaded JSON's "private_key" field.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# Optional realtime sync tuning. Drive metadata is polled; Sheets is read only when the file changes.
REVISION_POLL_MS=3000
HARD_REFRESH_MS=300000
